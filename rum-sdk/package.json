{
  "name": "webvizion",
  "version": "1.0.0",
  "description": "Real user monitoring for the browser: Core Web Vitals, errors, page speed and sessions, sent to your own endpoint.",
  "keywords": [
    "rum",
    "real-user-monitoring",
    "web-vitals",
    "core-web-vitals",
    "performance",
    "error-tracking",
    "monitoring"
  ],
  "author": "Prabhjeet Singh",
  "license": "ISC",
  "homepage": "https://github.com/jeet1703/webvision/tree/main/rum-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeet1703/webvision.git",
    "directory": "rum-sdk"
  },
  "bugs": {
    "url": "https://github.com/jeet1703/webvision/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/webvizion.min.global.js",
  "jsdelivr": "./dist/webvizion.min.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
